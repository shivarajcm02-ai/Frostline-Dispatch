# Copy this file to .env and fill in real values before running.

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# Where the SQLite database file is stored
DB_PATH=./data/frostline.db

# Login shown to anyone opening the board (HTTP Basic Auth).
# Pick a real password here — do not use these example values.
DASH_USER=denise
DASH_PASS=1234

# Set to "true" only for local testing without a login prompt.
# Never set this to true on a public server.
DISABLE_AUTH=false
